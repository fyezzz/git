# CodeOpsAcq environment template. NAMES ONLY: never commit real values.
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

DATABASE_URL=
REDIS_URL=
APP_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
SESSION_SECRET=
ENCRYPTION_KEY=

# AI providers (all optional; deterministic fallback when none are set)
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
AI_MODEL_OVERRIDE=

BOOTSTRAP_SUPER_ADMIN_EMAIL=
SEED_CATALOG=
SEED_WORKSPACE_SLUG=

# Compose-only Postgres credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# LiveKit (provisioned, unwired)
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=

# Stripe (billing enforcement is OFF until STRIPE_SECRET_KEY is set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
