{
  "name": "codeopsacq-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @codeopsacq/database db:generate && pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "db:migrate": "pnpm --filter @codeopsacq/database db:migrate",
    "db:seed:catalog": "pnpm --filter @codeopsacq/database db:seed:catalog"
  }
}
