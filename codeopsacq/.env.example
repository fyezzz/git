# Postgres (Supabase: Project Settings → Database → Connection string → "Transaction pooler", port 6543).
# Unset in development = local embedded Postgres saved to ./.data
DATABASE_URL=

# Password for the /app workspace. Required in production.
APP_PASSWORD=

# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://codeopsacq.com

# Optional: enables AI narrative synthesis in AI Command (analyses run without it).
ANTHROPIC_API_KEY=

# Optional: raises the GitHub intake rate limit (public data only).
GITHUB_TOKEN=
